# ============================================================================
# Telegram
# ============================================================================
TELEGRAM_TOKEN=123456:ABC-your-telegram-bot-token

# ============================================================================
# Pinecone
# ============================================================================
PINECONE_API_KEY=pcsk_your-pinecone-key
PINECONE_INDEX_NAME=rag-bot-index
# Необязательно: параметры serverless-индекса (создаётся автоматически)
# PINECONE_REGION=us-east-1
# PINECONE_CLOUD=aws

# ============================================================================
# OpenAI-совместимый провайдер (ProxyAPI).
# ВАЖНО: все эмбеддинги и вся генерация идут через этот base URL,
# имена моделей — С ПРЕФИКСОМ провайдера (openai/...).
# ============================================================================
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.proxyapi.ru/v1
OPENAI_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# ============================================================================
# RAG / история (значения по умолчанию — в config.py)
# ============================================================================
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_SEARCH_RESULTS=4
# MAX_HISTORY=20
# MAX_CONTEXT_DOCUMENTS=5
# MAX_AGENT_STEPS=8

# ============================================================================
# Командный помощник (групповые чаты)
# ============================================================================
# Namespace для сообщений команды и резюме встреч
# NAMESPACE_GROUP_MESSAGES=group_messages
# NAMESPACE_GROUP_SUMMARIES=group_summaries
# Сколько сообщений поднимать из Pinecone на вопрос команды
# GROUP_RETRIEVAL_TOP_K=8
# Писать ли все сообщения группы всегда (true) или только между
# /start_listening и /stop_listening (false)
# GROUP_ALWAYS_RECORD=true

# Extractive QA (дословные цитаты, требует transformers-haystack).
# Включите true после: pip install transformers-haystack
# USE_EXTRACTIVE_READER=false
# EXTRACTIVE_READER_MODEL=deepset/roberta-base-squad2
# EXTRACTIVE_TOP_K=3

# ============================================================================
# Порог косинусного сходства для дедупликации и действие при дубликате
# задаются ГЛОБАЛЬНЫМИ переменными в начале файла pinecone_manager.py:
#   COSINE_SIMILARITY_THRESHOLD, DUPLICATE_ACTION, DEDUPE_ENABLED
# ============================================================================
